<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.bankanalyzer</groupId>
        <artifactId>bank-statement-analyzer</artifactId>
        <version>1.3.0</version>
    </parent>

    <artifactId>gateway-module</artifactId>
    <packaging>jar</packaging>
    <name>Bank Statement Analyzer - Gateway</name>

    <!--
        REST entrypoint, webhook notifications, rate limiting, CORS, OpenAPI docs,
        and the shared cache config. Assembles parser/report/analysis modules into
        the one runnable Spring Boot app (still a single deployable at Phase 2 —
        see the parent pom for the full module-boundary rationale).
    -->
    <dependencies>
        <dependency>
            <groupId>com.bankanalyzer</groupId>
            <artifactId>bank-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bankanalyzer</groupId>
            <artifactId>parser-module</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bankanalyzer</groupId>
            <artifactId>report-module</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bankanalyzer</groupId>
            <artifactId>analysis-module</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j-core</artifactId>
            <version>8.10.1</version>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.5.0</version>
        </dependency>
        <dependency>
            <groupId>com.github.loki4j</groupId>
            <artifactId>loki-logback-appender</artifactId>
            <version>1.5.2</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <finalName>bank-statement-analyzer-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.bankanalyzer.BankAnalyzerApplication</mainClass>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
